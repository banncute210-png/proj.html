</div>
</div>
</div>
</main>
</div>

<script>
(() => {
const $ = id => document.getElementById(id);

const birthdayLanguages = {
vi:{title:"Chúc Mừng Sinh Nhật",message:"Chúc bạn luôn xinh đẹp và hạnh phúc! 💗",banner:"CHÚC MỪNG SINH NHẬT",age:n=>`Chúc mừng sinh nhật tuổi ${n}!`},
en:{title:"Happy Birthday",message:"Wishing you a day full of joy! 💗",banner:"HAPPY BIRTHDAY",age:n=>`Celebrating ${n} today!`},
ja:{title:"お誕生日おめでとう",message:"素敵な一年になりますように！ 💗",banner:"お誕生日おめでとう",age:n=>`${n}歳のお誕生日おめでとう！`},
ko:{title:"생일 축하해요",message:"행복하고 사랑스러운 하루 보내세요! 💗",banner:"생일 축하해요",age:n=>`${n}번째 생일을 축하해요!`},
"zh-CN":{title:"生日快乐",message:"愿你每天开心，永远幸福！ 💗",banner:"生日快乐",age:n=>`祝你${n}岁生日快乐！`},
"zh-TW":{title:"生日快樂",message:"願你每天開心，永遠幸福！ 💗",banner:"生日快樂",age:n=>`祝你${n}歲生日快樂！`},
th:{title:"สุขสันต์วันเกิด",message:"ขอให้มีความสุขและสดใสทุกวัน! 💗",banner:"สุขสันต์วันเกิด",age:n=>`สุขสันต์วันเกิดอายุ ${n} ปี!`},
hi:{title:"जन्मदिन मुबारक",message:"आपका हर दिन खुशियों से भरा हो! 💗",banner:"जन्मदिन मुबारक",age:n=>`${n}वें जन्मदिन की शुभकामनाएँ!`},
ar:{title:"عيد ميلاد سعيد",message:"أتمنى لك يوماً مليئاً بالسعادة! 💗",banner:"عيد ميلاد سعيد",age:n=>`عيد ميلاد سعيد ${n}!`},
