
<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Sweet Birthday Studio 🎀</title>

<link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&family=Baloo+2:wght@500;600;700;800&family=Pacifico&family=Caveat:wght@400;500;600;700&family=Dancing+Script:wght@400;500;600;700&family=Great+Vibes&family=Comfortaa:wght@400;500;600;700&family=Quicksand:wght@400;500;600;700&family=Lobster&family=Nunito:wght@400;500;600;700;800&family=Playfair+Display:wght@400;500;600;700&family=Noto+Sans:wght@400;500;600;700;800&family=Noto+Sans+JP:wght@400;500;600;700&family=Noto+Sans+KR:wght@400;500;600;700&family=Noto+Sans+SC:wght@400;500;600;700&family=Noto+Sans+TC:wght@400;500;600;700&family=Noto+Sans+Arabic:wght@400;500;600;700&family=Noto+Sans+Thai:wght@400;500;600;700&family=Noto+Sans+Devanagari:wght@400;500;600;700&display=swap" rel="stylesheet">

<script src="https://cdn.jsdelivr.net/npm/html2canvas@1.4.1/dist/html2canvas.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gif.js/0.2.0/gif.js"></script>

<style>
/* ===== SOFT PASTEL UI ===== */
:root {
  --ui-pink: #ee4d9b;
  --ui-purple: #8867df;
  --ui-text: #514568;
  --ui-muted: #9b91ad;
  --ui-border: #eee5f6;
  --ui-radius: 16px;
  --ui-shadow: 0 8px 28px rgba(91, 62, 125, .07);
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  font-family: "Nunito", sans-serif;
  color: var(--ui-text);
  background: #f7f3fc;
}

button, input, select {
  font: inherit;
}

button {
  cursor: pointer;
  border: 0;
  border-radius: 13px;
  padding: 10px 13px;
  background: var(--ui-purple);
  color: white;
  font-weight: 800;
  font-size: 12px;
  transition: transform .18s ease, box-shadow .18s ease, filter .18s ease;
}

button:hover {
  filter: brightness(1.035);
  transform: translateY(-2px);
  box-shadow: 0 7px 17px rgba(112, 78, 157, .13);
}

button:active {
  transform: scale(.97);
}

button.secondary {
  background: #f2ebfb;
  color: #654f89;
}

button:disabled {
  opacity: .6;
  cursor: wait;
  transform: none;
}

.app {
  display: grid;
  grid-template-columns: 290px minmax(0, 1fr);
  min-height: 100vh;
  background: #f7f3fc;
}

/* Sidebar gọn gàng */
.sidebar {
  min-width: 0;
  background: rgba(255,255,255,.98);
  padding: 19px 15px 25px;
  max-height: 100vh;
  overflow-y: auto;
  border: 0;
  border-right: 1px solid #eee7f5;
  box-shadow: 4px 0 24px rgba(80,57,111,.035);
  scrollbar-width: thin;
  scrollbar-color: #e2d4f1 transparent;
}

.sidebar::-webkit-scrollbar {
  width: 6px;
}

.sidebar::-webkit-scrollbar-thumb {
  background: #e5d8f1;
  border-radius: 20px;
}

.sidebar h1 {
  font-size: 18px;
  line-height: 1.45;
  margin: 0 0 19px;
  padding: 3px 2px 16px;
  border-bottom: 1px solid #f0e8f7;
  color: #493766;
  font-weight: 800;
  letter-spacing: -.35px;
}

.sidebar h2 {
  font-size: 11px;
  line-height: 1.4;
  color: #9b83b7;
  text-transform: uppercase;
  letter-spacing: .8px;
  margin: 22px 0 11px;
  font-weight: 800;
}

label {
  display: block;
  font-size: 11px;
  line-height: 1.45;
  margin: 11px 0 6px;
  color: #796a90;
  font-weight: 650;
}

input[type=text],
input[type=number],
select {
  display: block;
  width: 100%;
  min-width: 0;
  min-height: 39px;
  padding: 9px 11px;
  border: 1px solid #e8dff1;
  border-radius: 12px;
  background: #fff;
  color: #514568;
  outline: none;
  font-size: 12px;
  transition: border-color .2s, box-shadow .2s, background .2s;
}

input[type=text]:hover,
input[type=number]:hover,
select:hover {
  border-color: #d9c5ef;
}

input[type=text]:focus,
input[type=number]:focus,
select:focus {
  border-color: #bd9be9;
  background: #fffafd;
  box-shadow: 0 0 0 3px rgba(173,130,225,.13);
}

input[type=range] {
  width: 100%;
  margin: 8px 0;
  accent-color: #a17add;
  cursor: pointer;
}

input[type=color] {
  width: 100%;
  max-width: 100%;
  height: 37px;
  padding: 3px;
  border: 1px solid #eee4f5;
  border-radius: 10px;
  background: white;
  cursor: pointer;
}

.hint {
  font-size: 11px;
  color: #9b8caf;
  line-height: 1.65;
  margin: 7px 0;
}

.upload {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 5px;
  min-height: 64px;
  padding: 12px;
  background: #fbf7ff;
  border: 1px dashed #cdb4ed;
  border-radius: 14px;
  text-align: center;
  color: #8867c9;
  cursor: pointer;
  font-weight: 800;
  transition: background .2s, border-color .2s;
}

.upload:hover {
  background: #f6edff;
  border-color: #a98ad8;
}

.upload input {
  display: none;
}

.btnrow {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 9px;
}

.btnrow > * {
  flex: 1;
  min-width: 0;
}

.colors {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 8px;
}

.colors > div {
  min-width: 0;
}

.colors label {
  font-size: 10px;
  line-height: 1.35;
  min-height: 27px;
  margin-top: 5px;
}

.checks label {
  display: flex;
  align-items: center;
  gap: 9px;
  margin: 8px 0;
  padding: 9px 10px;
  background: #fff;
  border: 1px solid #f0e8f7;
  border-radius: 11px;
  font-size: 11px;
}

input[type=checkbox] {
  accent-color: #a17add;
  cursor: pointer;
}

.asset-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 7px;
}

.asset-grid button {
  min-width: 0;
  font-size: 23px;
  background: #fbf7ff;
  padding: 8px 3px;
  border: 1px solid #eee3fa;
  border-radius: 12px;
}

#status {
  font-size: 11px;
  color: #7658bd;
  margin-top: 10px;
  line-height: 1.6;
  min-height: 16px;
}

/* Khu vực xem trước */
.main {
  min-width: 0;
  padding: 22px 19px;
  background: #f7f3fc;
}

.toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 13px;
  flex-wrap: wrap;
  margin-bottom: 17px;
}

.toolbar h2 {
  font-size: 18px;
  margin: 0;
  color: #51416b;
  letter-spacing: -.4px;
}

.toolbar p {
  font-size: 12px;
  color: #9b8caf;
  margin: 5px 0 0;
  line-height: 1.6;
}

.toolbar .btnrow {
  margin-top: 0;
  align-items: center;
  justify-content: flex-end;
}

.toolbar button {
  min-height: 43px;
  padding: 11px 15px;
  border-radius: 13px;
  white-space: normal;
}

#export {
  background: linear-gradient(135deg, #9774e8, #8060d8);
  box-shadow: 0 5px 13px rgba(112,78,157,.12);
}

#exportGif {
  background: linear-gradient(135deg, #f35ca5, #e94391);
  box-shadow: 0 5px 13px rgba(238,77,155,.13);
}

.preview {
  min-height: calc(100vh - 110px);
  display: grid;
  place-items: center;
  padding: 15px;
  background: #eee8f5;
  border: 1px solid rgba(255,255,255,.9);
  border-radius: 25px;
  box-shadow: var(--ui-shadow);
}

#stage {
  position: relative;
  isolation: isolate;
  overflow: hidden;
  width: 100%;
  max-width: 1400px;
  aspect-ratio: 16 / 9;
  min-height: 380px;
  border-radius: 17px;
  color: #583c72;
  background: linear-gradient(135deg,#ffe6f1,#e4e7ff);
  box-shadow: 0 10px 32px rgba(77,52,99,.08);
}

#bgPhoto {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: none;
  z-index: -2;
}

#shade {
  position: absolute;
  inset: 0;
  background: #ffe6f1;
  opacity: .25;
  z-index: -1;
  pointer-events: none;
}

.layer {
  position: absolute;
  inset: 0;
  pointer-events: none;
}

#confetti { z-index: 1; }
#bunting { z-index: 2; }
#balloons { z-index: 3; }
#decorLayer { z-index: 5; pointer-events: none; }

#content {
  position: relative;
  z-index: 4;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  text-align: center;
  padding: 140px 20px 20px;
  gap: 5px;
  pointer-events: none;
}

#tTitle {
  font-size: 70px;
  line-height: 1.15;
  margin: 0;
  overflow-wrap: anywhere;
  text-shadow: 0 3px 0 #0001;
}

#tName {
  font-size: 40px;
  font-weight: 800;
  margin: 0;
  overflow-wrap: anywhere;
}

#tAge {
  font-size: 22px;
  margin: 0;
}

#tMsg {
  font-size: 18px;
  max-width: 85%;
  margin: 8px 0 0;
  overflow-wrap: anywhere;
}

#cake {
  width: 210px;
  max-width: 38%;
  margin-top: 8px;
}

.balloon {
  position: absolute;
  border-radius: 50% 50% 48% 48% / 58% 58% 42% 42%;
  box-shadow: inset -8px -10px 18px #0002;
  pointer-events: none;
  animation: float 3s ease-in-out infinite alternate;
}

.balloon:before {
  content: "";
  position: absolute;
  top: 14%;
  left: 20%;
  width: 22%;
  height: 16%;
  border-radius: 50%;
  background: #ffffff99;
  transform: rotate(-30deg);
}

.balloon:after {
  content: "";
  position: absolute;
  top: 98%;
  left: 50%;
  height: 75px;
  border-left: 1px solid #5558;
}

.confetti {
  position: absolute;
  top: -20px;
  animation: fall linear infinite;
}

@keyframes fall {
  to { transform: translateY(115vh) rotate(720deg); }
}

@keyframes float {
  to { transform: translateY(-15px) rotate(4deg); }
}

.sticker {
  position: absolute;
  pointer-events: auto;
  cursor: grab;
  user-select: none;
  touch-action: none;
  display: grid;
  place-items: center;
}

.sticker.selected {
  outline: 2px dashed #8466d9;
  outline-offset: 3px;
  border-radius: 8px;
}

.sticker img {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

#stage.still * {
  animation: none !important;
}

/* ===== Responsive ===== */
@media (max-width: 1100px) {
  .app {
    grid-template-columns: 270px minmax(0, 1fr);
  }

  .sidebar {
    padding: 17px 12px 22px;
  }

  .main {
    padding: 16px 13px;
  }

  .preview {
    padding: 10px;
    border-radius: 20px;
  }

  .toolbar button {
    padding: 10px 12px;
  }
}

@media (max-width: 850px) {
  .app {
    grid-template-columns: 250px minmax(0, 1fr);
  }

  .main {
    padding: 10px;
  }

  .preview {
    min-height: 65vh;
    padding: 8px;
  }

  #stage {
    min-height: 360px;
  }

  .toolbar {
    align-items: flex-start;
  }
}

@media (max-width: 600px) {
  .app {
    display: flex;
    flex-direction: column;
  }

  .sidebar {
    max-height: none;
    border-right: 0;
    border-bottom: 1px solid #eee7f5;
    border-radius: 0 0 22px 22px;
    padding: 18px 15px;
  }

  .sidebar h1 {
    font-size: 18px;
  }

  .main {
    padding: 15px 10px;
  }

  .toolbar {
    flex-direction: column;
    align-items: stretch;
  }

  .toolbar .btnrow {
    width: 100%;
    justify-content: stretch;
  }

  .toolbar button {
    flex: 1;
    padding: 10px 8px;
  }

  .preview {
    min-height: 0;
    padding: 7px;
    border-radius: 17px;
  }

  #stage {
    min-height: 390px;
    aspect-ratio: 4 / 5;
    border-radius: 12px;
  }

  #content {
    padding-top: 27%;
  }

  #tTitle {
    font-size: clamp(28px, 8vw, 48px);
  }

  #tName {
    font-size: 28px;
  }

  #tAge {
    font-size: 17px;
  }

  #tMsg {
    font-size: 14px;
  }

  #cake {
    width: 145px;
  }
}

@media (prefers-reduced-motion: reduce) {
  button, input, select {
    transition: none;
  }
}
</style>
</head>

<body>
<div class="app">
<aside class="sidebar">
<h1>🎀 Sweet Birthday Studio</h1>

<h2>🌍 Ngôn ngữ</h2>
<label for="language">Ngôn ngữ thiệp</label>
<select id="language">
<option value="vi">🇻🇳 Tiếng Việt</option>
<option value="en" selected>🇺🇸 English</option>
<option value="ja">🇯🇵 日本語</option>
<option value="ko">🇰🇷 한국어</option>
<option value="zh-CN">🇨🇳 简体中文</option>
<option value="zh-TW">🇹🇼 繁體中文</option>
<option value="th">🇹🇭 ภาษาไทย</option>
<option value="hi">🇮🇳 हिन्दी</option>
<option value="ar">🇸🇦 العربية</option>
<option value="fr">🇫🇷 Français</option>
<option value="es">🇪🇸 Español</option>
<option value="ru">🇷🇺 Русский</option>
</select>
<p class="hint">Chọn ngôn ngữ để áp dụng lời chúc mẫu và font phù hợp. Bạn vẫn có thể sửa nội dung sau đó.</p>

<h2>📝 Nội dung</h2>
<label for="title">Tiêu đề</label><input id="title" value="Happy Birthday">
<label for="name">Tên người nhận</label><input id="name" value="Linh">
<label for="age">Tuổi (0 để ẩn)</label><input id="age" type="number" min="0" max="120" value="20">
<label for="msg">Lời chúc</label><input id="msg" value="Wishing you a day full of joy! 💗">
<label for="banner">Chữ trên dây cờ</label><input id="banner" value="HAPPY BIRTHDAY" maxlength="24">

<h2>🎀 Font chữ cute</h2>
<label for="font">Chọn phong cách chữ</label>
<select id="font">
<optgroup label="Cute & Kawaii">
<option value="Fredoka">Fredoka — Bubble cute</option>
<option value="Baloo 2">Baloo 2 — Tròn đáng yêu</option>
<option value="Comfortaa">Comfortaa — Mềm mại</option>
<option value="Nunito">Nunito — Ngọt ngào</option>
<option value="Quicksand">Quicksand — Minimal cute</option>
</optgroup>
<optgroup label="Handwritten & Coquette">
<option value="Pacifico">Pacifico — Viết tay</option>
<option value="Caveat">Caveat — Handwritten</option>
<option value="Dancing Script">Dancing Script — Nàng thơ</option>
<option value="Great Vibes">Great Vibes — Công chúa</option>
<option value="Lobster">Lobster — Vintage</option>
</optgroup>
<optgroup label="Elegant & đa ngôn ngữ">
<option value="Playfair Display">Playfair Display — Thanh lịch</option>
<option value="Noto Sans">Noto Sans — Đa ngôn ngữ</option>
<option value="Noto Sans JP">Noto Sans JP — Nhật</option>
<option value="Noto Sans KR">Noto Sans KR — Hàn</option>
<option value="Noto Sans SC">Noto Sans SC — Trung giản thể</option>
<option value="Noto Sans TC">Noto Sans TC — Trung phồn thể</option>
<option value="Noto Sans Arabic">Noto Sans Arabic — Ả Rập</option>
<option value="Noto Sans Thai">Noto Sans Thai — Thái</option>
<option value="Noto Sans Devanagari">Noto Sans Devanagari — Hindi</option>
</optgroup>
</select>
<label for="tSize">Kích thước tiêu đề</label>
<input id="tSize" type="range" min="25" max="100" value="70">

<h2>🖼️ Ảnh nền cá nhân</h2>
<label class="upload">＋ Chọn ảnh từ máy tính
<div class="hint">PNG, JPG, WEBP · tối đa 10 MB</div>
<input id="bgUpload" type="file" accept="image/*">
</label>
<div class="btnrow"><button class="secondary" id="removeBg">Bỏ ảnh nền</button></div>
<label for="bgOpacity">Độ đậm lớp phủ</label>
<input id="bgOpacity" type="range" min="0" max="90" value="25">
<label for="overlayColor">Màu lớp phủ</label>
<input id="overlayColor" type="color" value="#ffe6f1">

<h2>🎨 Màu sắc</h2>
<div class="colors">
<div><label>Nền trên</label><input type="color" id="bg1" value="#ffe6f1"></div>
<div><label>Nền dưới</label><input type="color" id="bg2" value="#e4e7ff"></div>
<div><label>Màu chữ</label><input type="color" id="ink" value="#583c72"></div>
<div><label>Hồng</label><input type="color" id="c1" value="#ff80ab"></div>
<div><label>Vàng</label><input type="color" id="c2" value="#ffd166"></div>
<div><label>Xanh dương</label><input type="color" id="c3" value="#83d8f8"></div>
<div><label>Xanh lá</label><input type="color" id="c4" value="#a8e6a3"></div>
</div>

<h2>🎈 Trang trí</h2>
<label>Số bóng bay: <span id="vBal">10</span></label>
<input id="nBal" type="range" min="0" max="24" value="10">
<label>Kích thước bóng bay</label>
<input id="sBal" type="range" min="60" max="160" value="100">
<label>Confetti: <span id="vCon">50</span></label>
<input id="nCon" type="range" min="0" max="120" value="50">
<div class="checks">
<label><input type="checkbox" id="onBun" checked> Dây cờ</label>
<label><input type="checkbox" id="onCake" checked> Bánh kem</label>
<label><input type="checkbox" id="onAnim" checked> Animation</label>
</div>

<h2>✨ Sticker</h2>
<div class="asset-grid" id="assetGrid">
<button data-emoji="💖">💖</button><button data-emoji="⭐">⭐</button>
<button data-emoji="🎁">🎁</button><button data-emoji="🌸">🌸</button>
<button data-emoji="🎉">🎉</button><button data-emoji="🦋">🦋</button>
<button data-emoji="🍓">🍓</button><button data-emoji="✨">✨</button>
