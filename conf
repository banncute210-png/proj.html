};

const suggestedFonts={
vi:"Fredoka",en:"Fredoka",ja:"Noto Sans JP",ko:"Noto Sans KR",
"zh-CN":"Noto Sans SC","zh-TW":"Noto Sans TC",th:"Noto Sans Thai",
hi:"Noto Sans Devanagari",ar:"Noto Sans Arabic",fr:"Quicksand",
es:"Baloo 2",ru:"Nunito"
};

const fallbacks={
vi:'"Noto Sans",sans-serif',en:'"Noto Sans",sans-serif',ja:'"Noto Sans JP",sans-serif',ko:'"Noto Sans KR",sans-serif',
"zh-CN":'"Noto Sans SC",sans-serif',"zh-TW":'"Noto Sans TC",sans-serif',th:'"Noto Sans Thai",sans-serif',hi:'"Noto Sans Devanagari",sans-serif',ar:'"Noto Sans Arabic",sans-serif',fr:'"Noto Sans",sans-serif',es:'"Noto Sans",sans-serif',ru:'"Noto Sans",sans-serif'
};

let seed=7,backgroundData=null,stickers=[],selected=null,stickerId=0;

function palette(){return [$('c1').value,$('c2').value,$('c3').value,$('c4').value]}
function rng(seedValue){return function(){let t=seedValue+=0x6D2B79F5;t=Math.imul(t^t>>>15,t|1);t^=t+Math.imul(t^t>>>7,t|61);return ((t^t>>>14)>>>0)/4294967296}}
function safeText(v){return String(v).replace(/[<>&"]/g,"")}

function makeCake(c){
return `<svg viewBox="0 0 240 210" width="100%" xmlns="http://www.w3.org/2000/svg">
<ellipse cx="120" cy="198" rx="112" ry="9" fill="#0002"/>
<rect x="20" y="130" width="200" height="66" rx="12" fill="${c[1]}"/>
<rect x="20" y="130" width="200" height="16" rx="8" fill="${c[0]}"/>
<rect x="48" y="82" width="144" height="54" rx="12" fill="${c[3]}"/>
<rect x="48" y="82" width="144" height="14" rx="7" fill="${c[0]}"/>
<circle cx="52" cy="170" r="5" fill="${c[0]}"/><circle cx="92" cy="176" r="5" fill="${c[2]}"/>
<circle cx="132" cy="170" r="5" fill="${c[0]}"/><circle cx="172" cy="176" r="5" fill="${c[2]}"/>
<rect x="116" y="52" width="8" height="30" rx="2" fill="${c[2]}"/>
<ellipse cx="120" cy="44" rx="5" ry="9" fill="#ffb703" class="flame"/>
</svg>`;
}

function makeBanner(text,c){
const chars=safeText(text).replace(/\s+/g,"").slice(0,24).split("");
if(!chars.length)return "";
let svg=`<svg viewBox="0 0 1000 200" width="100%" xmlns="http://www.w3.org/2000/svg"><path d="M0 8 Q500 120 1000 8" fill="none" stroke="#555" stroke-width="3"/>`;
chars.forEach((ch,i)=>{
const t=(i+1)/(chars.length+1),x=1000*t,y=(1-t)*(1-t)*8+2*(1-t)*t*64+t*t*8,w=Math.min(1000/(chars.length+1)*.92,84),h=w*1.15;
svg+=`<polygon points="${x-w/2},${y} ${x+w/2},${y} ${x},${y+h}" fill="${c[i%c.length]}" stroke="#0002"/><text x="${x}" y="${y+h*.5}" text-anchor="middle" dominant-baseline="middle" font-size="${w*.5}" font-weight="800" fill="white">${ch}</text>`;
});
return svg+"</svg>";
}

function render(){
const lang=$('language').value,c=palette(),stage=$('stage');
const age=Math.max(0,Math.min(120,Number($('age').value)||0));
stage.lang=lang;
stage.dir=lang==="ar"?"rtl":"ltr";
stage.style.fontFamily=`"${$('font').value}", ${fallbacks[lang]}`;
stage.style.background=`linear-gradient(160deg,${$('bg1').value},${$('bg2').value})`;
stage.style.color=$('ink').value;
stage.classList.toggle('still',!$('onAnim').checked);

$('tTitle').textContent=$('title').value;
$('tTitle').style.fontSize=$('tSize').value+'px';
$('tName').textContent=$('name').value;
$('tAge').textContent=age?birthdayLanguages[lang].age(age):'';
$('tMsg').textContent=$('msg').value;
$('shade').style.background=$('overlayColor').value;
$('shade').style.opacity=Number($('bgOpacity').value)/100;

$('bunting').innerHTML=$('onBun').checked&&lang!=="ar"?makeBanner($('banner').value,c):'';
$('cake').innerHTML=$('onCake').checked?makeCake(c):'';
$('vBal').textContent=$('nBal').value;
$('vCon').textContent=$('nCon').value;

const rand=rng(seed);
let html='';
for(let i=0;i<Number($('nBal').value);i++){
const left=i%2===0?1+rand()*22:76+rand()*20;
const size=(50+rand()*28)*Number($('sBal').value)/100;
html+=`<div class="balloon" style="left:${left}%;bottom:${14+rand()*42}%;width:${size}px;height:${size*1.25}px;background:${c[Math.floor(rand()*c.length)]};animation-delay:-${rand()*4}s"></div>`;
}
$('balloons').innerHTML=html;

html='';
for(let i=0;i<Number($('nCon').value);i++){
const size=6+rand()*8,round=rand()>.5;
html+=`<span class="confetti" style="left:${rand()*100}%;width:${size}px;height:${round?size:size*1.8}px;border-radius:${round?'50%':'2px'};background:${c[Math.floor(rand()*c.length)]};animation-duration:${4+rand()*6}s;animation-delay:-${rand()*10}s"></span>`;
}
$('confetti').innerHTML=html;
}

function status(t){$('status').textContent=t}

function readImage(file,cb){
if(!file)return;
if(!file.type.startsWith('image/'))return status('Vui lòng chọn file hình ảnh.');
if(file.size>10*1024*1024)return status('Ảnh cần nhỏ hơn 10 MB.');
const r=new FileReader();
r.onload=()=>cb(r.result);
r.onerror=()=>status('Không đọc được ảnh.');
r.readAsDataURL(file);
}

$('bgUpload').addEventListener('change',e=>readImage(e.target.files[0],data=>{
backgroundData=data;
$('bgPhoto').src=data;
$('bgPhoto').style.display='block';
status('Đã cập nhật ảnh nền.');
}));

$('removeBg').onclick=()=>{
backgroundData=null;
$('bgPhoto').removeAttribute('src');
$('bgPhoto').style.display='none';
$('bgUpload').value='';
status('Đã bỏ ảnh nền.');
};

function addSticker(item){
const id='sticker-'+(++stickerId),el=document.createElement('div');
el.className='sticker';
el.dataset.id=id;
el.style.left='40%';
el.style.top='35%';
el.style.width=item.data?'100px':'64px';
el.style.height=item.data?'100px':'64px';

if(item.data){
const img=document.createElement('img');
img.src=item.data;
img.alt='Sticker';
el.appendChild(img);
}else{
el.textContent=item.emoji;
el.style.fontSize='48px';
}

$('decorLayer').appendChild(el);
const s={id,emoji:item.emoji||null,data:item.data||null,left:40,top:35,width:item.data?100:64,height:item.data?100:64};
stickers.push(s);
drag(el,s);
selectSticker(el);
}

function selectSticker(el){
document.querySelectorAll('.sticker').forEach(x=>x.classList.toggle('selected',x===el));
selected=el?el.dataset.id:null;
}

function drag(el,s){
let sx=0,sy=0,ox=0,oy=0,moving=false,rect;

el.addEventListener('pointerdown',e=>{
e.preventDefault();
e.stopPropagation();
selectSticker(el);
rect=$('stage').getBoundingClientRect();
sx=e.clientX;
sy=e.clientY;
ox=parseFloat(el.style.left)||0;
oy=parseFloat(el.style.top)||0;
moving=true;
el.setPointerCapture(e.pointerId);
});

el.addEventListener('pointermove',e=>{
if(!moving)return;
s.left=Math.max(0,Math.min(94,ox+(e.clientX-sx)/rect.width*100));
s.top=Math.max(0,Math.min(90,oy+(e.clientY-sy)/rect.height*100));
el.style.left=s.left+'%';
el.style.top=s.top+'%';
});

el.addEventListener('pointerup',()=>moving=false);
el.addEventListener('pointercancel',()=>moving=false);
}

$('assetGrid').onclick=e=>{
const b=e.target.closest('[data-emoji]');
if(b)addSticker({emoji:b.dataset.emoji});
};

$('decorUpload').onchange=e=>readImage(e.target.files[0],data=>{
addSticker({data});
e.target.value='';
status('Đã thêm sticker. Bạn có thể kéo để di chuyển.');
});

$('deleteSticker').onclick=()=>{
if(!selected)return status('Hãy chọn sticker cần xóa.');
document.querySelector(`[data-id="${selected}"]`)?.remove();
stickers=stickers.filter(s=>s.id!==selected);
selected=null;
};

$('clearStickers').onclick=()=>{
stickers=[];
selected=null;
$('decorLayer').innerHTML='';
};

document.addEventListener('pointerdown',e=>{
if(!e.target.closest('.sticker'))selectSticker(null);
});

document.querySelectorAll('.sidebar input,.sidebar select').forEach(el=>{
el.addEventListener('input',render);
});

$('language').addEventListener('change',()=>{
const lang=$('language').value,d=birthdayLanguages[lang];
$('title').value=d.title;
$('msg').value=d.message;
$('banner').value=d.banner;
$('font').value=suggestedFonts[lang]||'Fredoka';
render();
});

$('shuffle').onclick=()=>{
seed=Math.random()*1000000|0;
render();
};

$('fullscreen').onclick=async()=>{
try{
if(document.fullscreenElement)await document.exitFullscreen();
else await $('stage').requestFullscreen();
}catch{
status('Không thể bật toàn màn hình trên trình duyệt này.');
}
};

$('export').onclick=async()=>{
const b=$('export');
b.disabled=true;
b.textContent='Đang xuất...';
try{
await document.fonts.ready;
const canvas=await html2canvas($('stage'),{scale:2,useCORS:true,backgroundColor:null,logging:false});
const a=document.createElement('a');
a.download='sweet-birthday-card.png';
a.href=canvas.toDataURL('image/png');
a.click();
status('Đã tải thiệp PNG.');
}catch(e){
status('Xuất ảnh thất bại. Hãy kiểm tra kết nối và thử lại.');
}finally{
b.disabled=false;
b.textContent='Tải thiệp PNG';
}
};

/* Xuất GIF động */
$('exportGif').onclick=async()=>{
const btn=$('exportGif');
if(typeof GIF==='undefined'){
status('Không tải được thư viện GIF. Hãy kiểm tra kết nối Internet.');
return;
}

btn.disabled=true;
btn.textContent='Đang tạo GIF...';
status('Đang chụp các khung hình. Vui lòng chờ...');

let gif=null;
try{
await document.fonts.ready;

const stage=$('stage');
const frameCount=12;
const delay=160;
const frames=[];

for(let i=0;i<frameCount;i++){
const canvas=await html2canvas(stage,{
scale:1,
useCORS:true,
backgroundColor:null,
logging:false
});
frames.push(canvas);
await new Promise(resolve=>setTimeout(resolve,delay));
}

gif=new GIF({
workers:2,
quality:10,
width:frames[0].width,
height:frames[0].height,
workerScript:'https://cdnjs.cloudflare.com/ajax/libs/gif.js/0.2.0/gif.worker.js'
});

frames.forEach(canvas=>{
gif.addFrame(canvas,{delay,copy:true});
});

status('Đang ghép GIF...');
gif.on('progress',p=>{
status('Đang tạo GIF: '+Math.round(p*100)+'%');
});

gif.on('finished',blob=>{
const url=URL.createObjectURL(blob);
const a=document.createElement('a');
a.href=url;
a.download='sweet-birthday-card.gif';
document.body.appendChild(a);
a.click();
a.remove();

setTimeout(()=>URL.revokeObjectURL(url),10000);
status('Đã xuất GIF. Nếu file không tải được, hãy kiểm tra quyền tải xuống của trình duyệt.');
btn.disabled=false;
btn.textContent='🎞️ Save as GIF';
});

gif.on('abort',()=>{
status('Đã hủy quá trình tạo GIF.');
btn.disabled=false;
btn.textContent='🎞️ Save as GIF';
});

gif.render();
}catch(e){
console.error(e);
status('Không tạo được GIF. Thử tải lại trang hoặc kiểm tra kết nối Internet.');
btn.disabled=false;
btn.textContent='🎞️ Save as GIF';
}
};

const presets={
pastel:['#ffe6f1','#e4e7ff','#583c72','#ff80ab','#ffd166','#83d8f8','#a8e6a3'],
sunset:['#ffb199','#ffdfba','#713b53','#f15bb5','#fee440','#00bbf9','#00f5d4'],
night:['#171c48','#433078','#fff5d6','#ff5d8f','#ffc93c','#4cc9f0','#b8f28b']
};

document.querySelectorAll('.preset').forEach(b=>b.onclick=()=>{
const p=presets[b.dataset.preset];
['bg1','bg2','ink','c1','c2','c3','c4'].forEach((id,i)=>$(id).value=p[i]);
$('overlayColor').value=p[0];
$('bgOpacity').value=b.dataset.preset==='night'?15:25;
render();
});

const ids=['language','title','name','age','msg','banner','font','tSize','bgOpacity','overlayColor','bg1','bg2','ink','c1','c2','c3','c4','nBal','sBal','nCon','onBun','onCake','onAnim'];

function getState(){
const state={};
ids.forEach(id=>{
const el=$(id);
state[id]=el.type==='checkbox'?el.checked:el.value;
});
state.backgroundData=backgroundData;
state.stickers=stickers.map(s=>({...s}));
state.seed=seed;
return state;
}

function applyState(s){
ids.forEach(id=>{
if(s[id]===undefined)return;
const el=$(id);
if(el.type==='checkbox')el.checked=!!s[id];
else el.value=s[id];
});

backgroundData=s.backgroundData||null;

if(backgroundData){
$('bgPhoto').src=backgroundData;
$('bgPhoto').style.display='block';
}else{
$('bgPhoto').removeAttribute('src');
$('bgPhoto').style.display='none';
}

seed=s.seed||7;
stickers=[];
selected=null;
$('decorLayer').innerHTML='';

(s.stickers||[]).forEach(item=>{
addSticker(item);
const obj=stickers[stickers.length-1];
const el=document.querySelector(`[data-id="${obj.id}"]`);
obj.left=item.left;
obj.top=item.top;
obj.width=item.width;
obj.height=item.height;
el.style.left=obj.left+'%';
el.style.top=obj.top+'%';
el.style.width=obj.width+'px';
el.style.height=obj.height+'px';
});

selectSticker(null);
render();
}

$('save').onclick=()=>{
try{
localStorage.setItem('sweetBirthdayStudio',JSON.stringify(getState()));
status('Đã lưu thiết kế trên trình duyệt này.');
}catch{
status('Không đủ dung lượng lưu. Hãy thử ảnh nhỏ hơn.');
}
};

$('load').onclick=()=>{
try{
const s=localStorage.getItem('sweetBirthdayStudio');
if(!s)return status('Chưa có bản lưu.');
applyState(JSON.parse(s));
status('Đã mở bản lưu.');
}catch{
status('Không thể mở bản lưu.');
}
};

$('reset').onclick=()=>{
if(confirm('Bạn muốn đặt lại toàn bộ thiết kế?'))location.reload();
};

render();
})();
</script>
